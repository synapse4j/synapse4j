<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.synapse4j</groupId>
    <artifactId>synapse4j-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../synapse4j-parent/pom.xml</relativePath>
  </parent>

  <artifactId>synapse4j-spring-boot-starter</artifactId>

  <!-- name is never inherited, so it is stated in every module; url and scm arrive
       unchanged from the root — its append-path flags are switched off. -->
  <name>synapse4j Spring Boot Starter</name>
  <description>Spring Boot auto-configuration for synapse4j's clients, transports and JSON support.</description>

  <!-- The Spring Boot integration: it wires the Jackson codec, a transport and a chat client into
       the context, bound to synapse4j.* properties — synapse4j.http-client picks between the
       Spring and Apache transports, synapse4j.chat-client between the OpenAI protocols and
       Anthropic's — and every bean backs off as soon as the application declares one of its own.
       Versions of all Spring dependencies come from the Boot BOM the parent imports — none are
       pinned in this file. That resolved version is what flatten inlines into the deployed pom, so
       the starter is built and tested against Spring Boot 4.1.1: an application on a different Boot
       line should import spring-boot-dependencies itself, so its own BOM wins. -->
  <dependencies>
    <dependency>
      <groupId>io.github.synapse4j</groupId>
      <artifactId>synapse4j-jackson</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.synapse4j</groupId>
      <artifactId>synapse4j-http-restclient</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The transport module only: Apache HttpClient 5 is excluded here and re-declared optional
         below, so this starter never carries the Apache library into an application. The Spring
         transport is the default, and putting another HTTP stack on the application's classpath
         behind its back is the application's decision to make, not ours. -->
    <dependency>
      <groupId>io.github.synapse4j</groupId>
      <artifactId>synapse4j-http-apache</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.httpcomponents.client5</groupId>
          <artifactId>httpclient5</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Compile and test only — optional is what keeps it off the application's classpath. An
         application that selects synapse4j.http-client=apache declares httpclient5 itself; without
         it that selection fails at startup with the library named, and the default wiring is
         untouched either way — the beans that name Apache types sit behind a class condition. -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.synapse4j</groupId>
      <artifactId>synapse4j-openai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.synapse4j</groupId>
      <artifactId>synapse4j-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- Carries the auto-configuration that publishes the prototype RestClient.Builder this
         starter builds its transport on, so Boot-side customizers, observations and
         spring.http.client.* settings ride along. No type of this module is referenced in our
         code: exclude it and the transport falls back to a plain RestClient.builder(). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
    </dependency>
    <!-- Carries the auto-configuration that publishes the JsonMapper the codec is built on, so
         spring.jackson.* and every JsonMapperBuilderCustomizer bean reach the schemas and the
         bindings the tools use. Since Boot 4 this auto-configuration lives here rather than in
         spring-boot-autoconfigure, so without this dependency an application that never asked
         for JSON support would silently get a codec of our own making. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Generates the configuration metadata so synapse4j.* keys complete in the IDE. Optional:
         build-time only, never a dependency of the consuming application. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths combine.children="append">
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>

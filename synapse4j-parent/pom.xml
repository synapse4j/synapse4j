<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- How the leaf modules are built: third-party dependency management, plugin versions and the
      formatting rules. Only the modules that compile and test code inherit this pom. -->
  <parent>
    <groupId>io.github.synapse4j</groupId>
    <artifactId>synapse4j-aggregator</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>synapse4j-parent</artifactId>
  <packaging>pom</packaging>

  <!-- name is never inherited, so it is stated in every module; url and scm arrive
       unchanged from the root — its append-path flags are switched off. -->
  <name>synapse4j Build Parent</name>
  <description>How the synapse4j modules are built: dependency management, plugin versions and formatting rules.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <jsonschema-generator.version>5.0.0</jsonschema-generator.version>

    <!-- The static checker that gives the @NullMarked declarations above their teeth: NullAway
         runs as an Error Prone plugin inside javac, so handing null to a parameter that is not
         nullable — or answering a non-null method with null — fails the build instead of a
         caller's runtime. Not managed by the Boot BOM, so pinned here. -->
    <error-prone.version>2.50.0</error-prone.version>
    <nullaway.version>0.14.2</nullaway.version>

    <!-- The one line this build rides: whatever spring-boot-dependencies pins is the version of
         Spring, Jackson, JUnit, Lombok and the rest. Nothing here pins a second version of
         anything it manages — one authority per artifact, and nothing to keep in sync. -->
    <spring-boot.version>4.1.1</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.github.victools</groupId>
        <artifactId>jsonschema-generator-bom</artifactId>
        <version>${jsonschema-generator.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Pin the lifecycle plugins this build runs (mvn clean verify). Maven's own defaults are
             Maven-2 era on Maven 3.x: clean 2.5, resources 2.6, compiler 3.1, surefire 2.12.4,
             jar 2.4, install 2.4, deploy 2.7 — and compiler 3.1 cannot even build on JDK 21. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <!-- Keep parameter names in the bytecode: the JSON codecs this library plugs in resolve
                 constructor parameters reflectively, so dropping them would change behaviour for
                 users even though this build itself never reads them. -->
            <parameters>true</parameters>
            <!-- The javac packages Error Prone's plugin needs are opened in .mvn/jvm.config rather
                 than here: the compiler runs inside Maven's own JVM, so the flags belong to the JVM
                 that starts it — and that file carries no explanation of its own, because Maven
                 reads every one of its lines as a single JVM argument. -->
            <compilerArgs>
              <arg>-XDcompilePolicy=simple</arg>
              <!-- javac's default stop policy on error is not one Error Prone can work with, and on
                   JDK 21 it has to be told to keep type annotations on symbols for the plugin. -->
              <arg>-XDshould-stop.ifError=FLOW</arg>
              <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
              <!-- Only NullAway runs, and as an error: Error Prone's own checks would be a second
                   standard to keep up with, unrelated to nullness. -->
              <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR
                -XepOpt:NullAway:AnnotatedPackages=io.github.synapse4j
                -XepOpt:NullAway:JSpecifyMode=true</arg>
            </compilerArgs>
            <!-- A renamed API is not left for an IDE to notice: Jackson 3 turned JsonNode.asText into
                 asString and this build said nothing. These two are elements rather than compiler args
                 so that the test execution below, which replaces the args list to drop the checker,
                 keeps them. -->
            <showDeprecation>true</showDeprecation>
            <failOnWarning>true</failOnWarning>
            <annotationProcessorPaths>
              <!-- Lombok generates the accessors and their null checks, so it has to be on the
                   processor path beside the checker; its version comes from the Boot BOM. -->
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </path>
              <path>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_core</artifactId>
                <version>${error-prone.version}</version>
              </path>
              <path>
                <groupId>com.uber.nullaway</groupId>
                <artifactId>nullaway</artifactId>
                <version>${nullaway.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
          <executions>
            <execution>
              <!-- The checker runs on main sources only: tests hand null to things on purpose —
                   asserting a refusal is how several of them pin a contract — and NullAway has no
                   path-based exclusion, so the plugin flag comes off this execution instead. Only the
                   argument list is replaced; the warning settings above are elements of their own and
                   still apply here. -->
              <id>default-testCompile</id>
              <configuration>
                <compilerArgs combine.self="override" />
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
          <configuration>
            <!-- Keeps the Implementation-Title/Version manifest entries the Spring Boot parent
                 used to add. -->
            <archive>
              <manifest>
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <removeUnusedImports />
            <!-- Import ordering is deliberately not enforced. The IDE's organize-imports action and
                 Spotless would each have to agree on the same grouping, and a mismatch would produce
                 exactly the editor/build inconsistency this configuration exists to prevent. Unused
                 imports are still removed on both sides. -->
            <eclipse>
              <!-- The root, where the profile lives. mvn sets this property from its launcher
                   script, m2e does not, hence the ignore below. Editing that profile needs a
                   `mvn clean` first: Spotless's freshness index does not notice it changing. -->
              <file>${maven.multiModuleProjectDirectory}/.vscode/eclipse-formatter.xml</file>
            </eclipse>
          </java>
        </configuration>
        <executions>
          <execution>
            <!-- m2e would fail to resolve the path above; the editor formats on save instead. -->
            <?m2e ignore?>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- What consumers import: the versions of this library's own modules, nothing else. The parent
       is the bare aggregator rather than the build parent, so no third-party dependency
       management is inherited that flatten would have to fight. Flatten itself comes from the
       aggregator; only the override below is declared here. -->
  <parent>
    <groupId>io.github.synapse4j</groupId>
    <artifactId>synapse4j-aggregator</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>synapse4j-bom</artifactId>
  <packaging>pom</packaging>

  <!-- name is never inherited, so it is stated in every module; url and scm arrive
       unchanged from the root — its append-path flags are switched off. -->
  <name>synapse4j BOM</name>
  <description>Bill of Materials for synapse4j: the module versions a consumer imports.</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <pomElements>
            <!-- The oss mode drops dependencyManagement, which for every other module is internal
                 bookkeeping and for this one is the artifact itself. Only this module's own entries
                 exist to resolve, so they come out with their versions inlined. -->
            <dependencyManagement>resolve</dependencyManagement>
          </pomElements>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.synapse4j</groupId>
        <artifactId>synapse4j-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.synapse4j</groupId>
        <artifactId>synapse4j-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.synapse4j</groupId>
        <artifactId>synapse4j-http-jdk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.synapse4j</groupId>
        <artifactId>synapse4j-http-restclient</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.synapse4j</groupId>
        <artifactId>synapse4j-http-apache</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.synapse4j</groupId>
        <artifactId>synapse4j-openai</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.synapse4j</groupId>
        <artifactId>synapse4j-anthropic</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.synapse4j</groupId>
        <artifactId>synapse4j-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>

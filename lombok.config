# Stop the search here: this is the project root, and nothing above it should be read.
config.stopBubbling = true

# Carry null contracts from source to Lombok's generated accessors: a @Nullable field's
# annotation must reach the getter's return and the setter's parameter, or every accessor of
# a null-marked class would promise non-null while the field starts out null.
lombok.addNullAnnotations = jspecify
lombok.copyableAnnotations += org.jspecify.annotations.Nullable

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
  child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <!-- The project-level append-path flag above (and the scm flags further down) keep a child's
       inherited url and scm exactly as written here instead of growing the module's path. -->

  <!-- The aggregator only: it lists what this build contains and carries the CI-friendly version.
       synapse4j-parent holds how the leaf modules are built; synapse4j-bom is what consumers
       import. Keeping the three apart means the BOM inherits nothing it does not publish. -->
  <groupId>io.github.synapse4j</groupId>
  <artifactId>synapse4j-aggregator</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <!-- The metadata every published pom carries: Central validates name, description, url,
       licenses, developers and scm on each artifact, and flatten inlines these inherited
       values into the pom each module is deployed with. -->
  <name>synapse4j</name>
  <description>A lightweight Java library for talking to LLM providers, decoupled from any particular framework.</description>
  <url>https://github.com/synapse4j/synapse4j</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>synapse4j</name>
      <url>https://github.com/synapse4j</url>
    </developer>
  </developers>
  <!-- The append-path flags stop Maven from tacking each module's directory onto these
       strings as they inherit; without them every child's connection ends in /module/path. -->
  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/synapse4j/synapse4j.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/synapse4j/synapse4j.git</developerConnection>
    <url>https://github.com/synapse4j/synapse4j</url>
  </scm>

  <properties>
    <revision>0.0.3-SNAPSHOT</revision>

    <!-- The versions of the build's own plugins, kept here so every pom that declares one of
         them — this file's spotless and flatten, the BOM's flatten override — references one
         place. -->
    <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    <spotless-maven-plugin.version>3.10.2</spotless-maven-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
  </properties>

  <modules>
    <module>synapse4j-parent</module>
    <module>synapse4j-bom</module>
    <module>synapse4j-core</module>
    <module>synapse4j-jackson</module>
    <module>synapse4j-http-jdk</module>
    <module>synapse4j-http-restclient</module>
    <module>synapse4j-http-apache</module>
    <module>synapse4j-openai</module>
    <module>synapse4j-anthropic</module>
    <module>synapse4j-spring-boot-starter</module>
  </modules>

  <build>
    <plugins>
      <!-- Checked before anything compiles: maven.compiler.release fails deep inside javac on an
           old JDK, after Spotless and flatten have already run, and the scm append-path flags
           below need a Maven new enough to honour them. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>This build compiles for Java 21 — run it on a JDK 21 or newer.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                  <message>This build relies on Maven behaviour introduced in 3.6.3.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Declared here with no configuration of its own so that a direct `spotless:apply` invocation
           from the root runs for every module in the reactor instead of failing on the ones without
           the plugin. The build parent carries the real configuration the leaf modules format with. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
      </plugin>
      <!-- Declared at the aggregator so every module flattens the same way — the deployed pom is
           this file's own raw pom for the root, and for everything below a self-contained oss pom
           carrying the coordinates, metadata and dependencies above, with no parent to fetch. The
           BOM adds only its dependencyManagement override. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>oss</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Everything a Maven Central release needs, off by default so a normal build never signs,
         never jars sources and never talks to a repository. Activated by -Prelease, which the
         release workflow does after the tag's CI has already gone green. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <configuration>
              <!-- A pom module has no sources: attach nothing there rather than an empty jar. -->
              <skipIfEmpty>true</skipIfEmpty>
            </configuration>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <configuration>
              <!-- Errors for malformed markup and broken links, silence for the missing-tag
                   noise: the prose carries the contract here, and a missing @param on a
                   one-line accessor must not hold a release hostage. -->
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- Replaces maven-deploy-plugin where it loads: uploads the whole reactor as one
               Central Portal deployment and waits until the bundle has validated — not until it is
               published. Publishing is automatic (autoPublish), but it runs on Central's queue,
               which has been slow enough to outlast a job's whole timeout; the release workflow
               waits for the published state itself, with its own bound, and stages a draft release
               when it does not arrive. waitMaxTime bounds this wait, and cannot be set below 1800. -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <deploymentName>synapse4j-${project.version}</deploymentName>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>validated</waitUntil>
              <waitMaxTime>1800</waitMaxTime>
              <!-- Central counts every file in the bundle against a monthly limit, and the default
                   "all" writes four checksums per artifact — one third of the whole deployment.
                   MD5 and SHA1 are the pair Central has always carried, and a client that wants
                   SHA-256 or SHA-512 falls back to SHA1 when they are absent. -->
              <checksums>required</checksums>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>

{
    "java.configuration.updateBuildConfiguration": "automatic",

    // Formatting comes from .vscode/eclipse-formatter.xml -- an Eclipse JDT formatter profile with
    // tabulation.char=space -- which is the same file Spotless uses at build time, so the editor
    // and `mvn spotless:apply` produce the same output.
    "java.format.settings.url": "${workspaceFolder}/.vscode/eclipse-formatter.xml",
    "java.format.settings.profile": "Eclipse",
    "editor.formatOnSave": true,

    // jdt.ls takes indentation from these client-side options rather than from the formatter
    // profile, so they must be pinned here (with detection off) to stay in sync with it.
    "[java]": {
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    }
}